<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Hello from Home page</h1>
    <a href="/signup">Sign up</a>
    <a href="/login">Login</a>
    <% if (Posts.length>0){  %>
       <% Posts.map((element)=>{  %>
            <h1>Title : <%=element.title %></h1>
            <p>Post : <%=element.body %></p>
            <form action="/delete/<%= element._id%>" , method="post">
                <button>Delete</button>
            </form>
            <a href="/Edit/<%= element._id%>">Edit</a>
            <!-- <a href="/delete/<%= element._id%>">delete</a> -->
             <form method="post" action="/newcomment/<%= element._id%>">
                <label>Write Your Comment</label>
                <input type="text" name="commentBody">
                <input type="submit"/>
             </form>
             <% element.commentid.map(comment=>{ %>
                <h5><%=comment.commentBody%></h5>
                <%})%>
      <%  }) %>
    <% } else { %>
        <h1>No Posts to show</h1>
    <% } %>
</body>
</html>